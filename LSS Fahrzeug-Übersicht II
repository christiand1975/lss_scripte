// ==UserScript==
// @name         LSS Fahrzeug-Uebersicht
// @namespace    https://www.leitstellenspiel.de/
// @version      1.1.0
// @description  Zeigt in der Leitstelle einen Tab mit einer tabellarischen Uebersicht aller Fahrzeuge der zugehÃ¶rigen Wachen inkl. FMS-Status (S1-S6), sowie einen zweiten Tab mit einer Auswertung Fahrzeuge pro Wache
// @author       Grisu
// @match        https://www.leitstellenspiel.de/buildings/*
// @grant        GM_xmlhttpRequest
// @connect      www.leitstellenspiel.de
// ==/UserScript==

(function () {
  'use strict';

  const TAB_ID    = 'grisu-fahrzeug-uebersicht';
  const TAB_ID2   = 'grisu-fahrzeuge-pro-wache';
  const STYLE_ID  = 'grisu-fahrzeug-style';
  const LSS_BASE  = 'https://www.leitstellenspiel.de';

  // FMS-Status (Standard BOS-Funk, gilt auch fÃ¼r LSS)
  const FMS_INFO = {
    '1': { text: 'Frei Funk',        cls: 'badge-ok' },
    '2': { text: 'Frei Wache',       cls: 'badge-ok' },
    '3': { text: 'Alarmiert',        cls: 'badge-partial' },
    '4': { text: 'Ankunft Einsatzort', cls: 'badge-partial' },
    '5': { text: 'Sprechwunsch',     cls: 'badge-missing' },
    '6': { text: 'Nicht einsatzbereit', cls: 'badge-none' },
    '0': { text: 'Notruf',           cls: 'badge-missing' },
  };

  // gecachte Fahrzeugliste, damit beide Tabs nicht doppelt laden
  let vehicleCache = null;
  let vehicleCachePromise = null;

  // â”€â”€â”€ Hilfsfunktionen â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

  function fetchDoc(url) {
    return new Promise((resolve, reject) => {
      GM_xmlhttpRequest({
        method: 'GET',
        url: LSS_BASE + url,
        responseType: 'document',
        onload: r => {
          if (r.response && r.response.querySelector) {
            resolve(r.response);
            return;
          }
          try {
            const doc = new DOMParser().parseFromString(r.responseText, 'text/html');
            resolve(doc);
          } catch (e) { reject(e); }
        },
        onerror: reject,
      });
    });
  }

  function getCurrentBuildingId() {
    const m = location.pathname.match(/\/buildings\/(\d+)/);
    return m ? m[1] : null;
  }

  function escHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  // â”€â”€â”€ CSS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

  function injectStyles() {
    if (document.getElementById(STYLE_ID)) return;
    const s = document.createElement('style');
    s.id = STYLE_ID;
    s.textContent = `
#${TAB_ID}-panel, #${TAB_ID2}-panel { padding: 12px 4px; font-size: 13px; }
#${TAB_ID}-panel .grisu-search {
  width: 100%; max-width: 360px; margin-bottom: 12px; padding: 5px 10px;
  border: 1px solid #999 !important; border-radius: 4px; font-size: 13px;
  box-sizing: border-box; color: #222 !important; background: #fff !important;
}
#${TAB_ID}-panel .grisu-filter-row { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; align-items: center; }
#${TAB_ID}-panel .grisu-btn-filter {
  padding: 4px 12px; border-radius: 12px; border: 2px solid #222 !important;
  background: #333 !important; color: #fff !important; cursor: pointer;
  font-size: 12px; font-weight: 600 !important; white-space: nowrap;
}
#${TAB_ID}-panel .grisu-btn-filter:hover { background: #111 !important; border-color: #000 !important; }
#${TAB_ID}-panel .grisu-btn-filter.active { background: #0066cc !important; color: #fff !important; border-color: #004499 !important; }
#${TAB_ID}-panel .grisu-table-wrap, #${TAB_ID2}-panel .grisu-table-wrap { overflow-x: auto; }
#${TAB_ID}-panel table.grisu-tbl, #${TAB_ID2}-panel table.grisu-tbl { width: 100%; border-collapse: collapse; font-size: 12px; }
#${TAB_ID}-panel table.grisu-tbl { min-width: 700px; }
#${TAB_ID}-panel table.grisu-tbl th, #${TAB_ID2}-panel table.grisu-tbl th {
  background: #e8e8e8 !important; color: #222 !important; border-bottom: 2px solid #bbb !important;
  padding: 6px 8px; text-align: left; white-space: nowrap; font-weight: 600; cursor: pointer; user-select: none;
}
#${TAB_ID}-panel table.grisu-tbl th:hover, #${TAB_ID2}-panel table.grisu-tbl th:hover { background: #d0d0d0 !important; color: #000 !important; }
#${TAB_ID}-panel table.grisu-tbl td, #${TAB_ID2}-panel table.grisu-tbl td {
  padding: 5px 8px; border-bottom: 1px solid #444 !important; vertical-align: middle;
  color: #fff !important; background: #111 !important;
}
#${TAB_ID}-panel table.grisu-tbl tr:hover td, #${TAB_ID2}-panel table.grisu-tbl tr:hover td { background: #1e1e2e !important; }
#${TAB_ID}-panel .grisu-badge {
  display: inline-block; padding: 2px 7px; border-radius: 10px; font-size: 11px;
  font-weight: 600; white-space: nowrap;
}
#${TAB_ID}-panel .badge-ok      { background:#1e7e1e !important; color:#fff !important; border:1px solid #155715; }
#${TAB_ID}-panel .badge-partial { background:#cc8800 !important; color:#fff !important; border:1px solid #996600; }
#${TAB_ID}-panel .badge-missing { background:#cc2200 !important; color:#fff !important; border:1px solid #991a00; }
#${TAB_ID}-panel .badge-none    { background:#555    !important; color:#fff !important; border:1px solid #333; }
#${TAB_ID}-panel .grisu-loading, #${TAB_ID2}-panel .grisu-loading { padding:20px; color:#333 !important; text-align:center; }
#${TAB_ID}-panel .grisu-error, #${TAB_ID2}-panel .grisu-error   { padding:20px; color:#cc2200 !important; font-weight:600; }
#${TAB_ID}-panel .grisu-summary { margin-bottom:10px; color:#333 !important; font-size:12px; }
#${TAB_ID}-panel .grisu-link, #${TAB_ID2}-panel .grisu-link    { color:#66aaff !important; text-decoration:none; }
#${TAB_ID}-panel .grisu-link:hover, #${TAB_ID2}-panel .grisu-link:hover { text-decoration:underline; }
#${TAB_ID}-panel .grisu-col-name { min-width:180px; }
#${TAB_ID}-panel .grisu-col-wache { min-width:140px; }
#${TAB_ID}-panel .sort-asc::after, #${TAB_ID2}-panel .sort-asc::after  { content:' â–²'; font-size:10px; }
#${TAB_ID}-panel .sort-desc::after, #${TAB_ID2}-panel .sort-desc::after { content:' â–¼'; font-size:10px; }
#${TAB_ID2}-panel .grisu-wache-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 18px 24px;
  align-items: start;
}
#${TAB_ID2}-panel .grisu-wache-block { margin-bottom: 0; }
#${TAB_ID2}-panel .grisu-wache-title {
  font-size: 14px; font-weight: 700; color: #222 !important; margin-bottom: 6px;
}
#${TAB_ID2}-panel table.grisu-tbl { max-width: none; width: 100%; }
#${TAB_ID2}-panel table.grisu-tbl td.grisu-col-count { text-align: center; width: 80px; }
`;
    document.head.appendChild(s);
  }

  // â”€â”€â”€ Tabs einfÃ¼gen â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

  function findTabContainer() {
    return document.querySelector('ul.nav-tabs');
  }

  function injectTab() {
    const ul = findTabContainer();
    if (!ul || document.getElementById(TAB_ID + '-tab')) return false;

    const li = document.createElement('li');
    li.innerHTML = `<a id="${TAB_ID}-tab" href="#${TAB_ID}-panel" data-toggle="tab">Fahrzeug-Uebersicht</a>`;
    ul.appendChild(li);

    const tabContent = document.querySelector('.tab-content');
    if (!tabContent) return false;

    const panel = document.createElement('div');
    panel.id = TAB_ID + '-panel';
    panel.className = 'tab-pane';
    panel.innerHTML = `<p class="grisu-loading">Tab anklicken zum Ladenâ€¦</p>`;
    tabContent.appendChild(panel);

    let loaded = false;
    document.getElementById(TAB_ID + '-tab').addEventListener('click', () => {
      if (!loaded) { loaded = true; loadData(panel); }
    });
    return true;
  }

  function injectTab2() {
    const ul = findTabContainer();
    if (!ul || document.getElementById(TAB_ID2 + '-tab')) return false;

    const li = document.createElement('li');
    li.innerHTML = `<a id="${TAB_ID2}-tab" href="#${TAB_ID2}-panel" data-toggle="tab">Fahrzeuge pro Wache</a>`;
    ul.appendChild(li);

    const tabContent = document.querySelector('.tab-content');
    if (!tabContent) return false;

    const panel = document.createElement('div');
    panel.id = TAB_ID2 + '-panel';
    panel.className = 'tab-pane';
    panel.innerHTML = `<p class="grisu-loading">Tab anklicken zum Ladenâ€¦</p>`;
    tabContent.appendChild(panel);

    let loaded = false;
    document.getElementById(TAB_ID2 + '-tab').addEventListener('click', () => {
      if (!loaded) { loaded = true; loadDataPerWache(panel); }
    });
    return true;
  }

  // â”€â”€â”€ Fahrzeugtabelle parsen â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

  function parseVehicleTable(doc) {
    const rows = [...doc.querySelectorAll('#vehicle_table tbody tr')];
    return rows.map(tr => {
      const tds = tr.querySelectorAll('td');
      const img = tds[0] ? tds[0].querySelector('img') : null;
      const typeLabel = img ? (img.getAttribute('alt') || '') : '';
      const typeId    = img ? (img.getAttribute('vehicle_type_id') || '') : '';

      const nameLink = tds[1] ? tds[1].querySelector('a[id^="vehicle_link_"]') : null;
      const name = nameLink ? nameLink.textContent.trim() : (tds[1] ? tds[1].textContent.trim() : '');
      const vehicleId = nameLink ? (nameLink.href.match(/\/vehicles\/(\d+)/) || [,''])[1] : '';

      const fmsSpan = tds[2] ? tds[2].querySelector('span[class*="building_list_fms_"]') : null;
      let fmsCode = '';
      if (fmsSpan) {
        const m = fmsSpan.className.match(/building_list_fms_(\d+)/);
        fmsCode = m ? m[1] : fmsSpan.textContent.trim();
      }

      const buildingLink = tds[3] ? tds[3].querySelector('a') : null;
      const buildingName = buildingLink ? buildingLink.textContent.trim() : (tds[3] ? tds[3].textContent.trim() : '');
      const buildingHref = buildingLink ? buildingLink.getAttribute('href') : '';

      const crew = tds[4] ? tds[4].textContent.trim() : '';

      return { name, vehicleId, typeLabel, typeId, fmsCode, buildingName, buildingHref, crew };
    });
  }

  // â”€â”€â”€ Daten laden (gecacht) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

  function loadVehicles() {
    if (vehicleCache) return Promise.resolve(vehicleCache);
    if (vehicleCachePromise) return vehicleCachePromise;

    const buildingId = getCurrentBuildingId();
    vehicleCachePromise = fetchDoc(`/buildings/${buildingId}/leitstelle-vehicles`)
      .then(doc => {
        vehicleCache = parseVehicleTable(doc);
        return vehicleCache;
      })
      .finally(() => { vehicleCachePromise = null; });
    return vehicleCachePromise;
  }

  async function loadData(panel) {
    panel.innerHTML = `<p class="grisu-loading">â³ Lade Fahrzeugdatenâ€¦</p>`;
    try {
      const vehicles = await loadVehicles();
      if (vehicles.length === 0) {
        panel.innerHTML = `<p class="grisu-error">Keine Fahrzeuge gefunden. Ist diese Seite eine Leitstelle mit zugeordneten Wachen?</p>`;
        return;
      }
      renderTable(panel, vehicles);
    } catch (e) {
      panel.innerHTML = `<p class="grisu-error">Fehler: ${e.message || e}</p>`;
    }
  }

  async function loadDataPerWache(panel) {
    panel.innerHTML = `<p class="grisu-loading">â³ Lade Fahrzeugdatenâ€¦</p>`;
    try {
      const vehicles = await loadVehicles();
      if (vehicles.length === 0) {
        panel.innerHTML = `<p class="grisu-error">Keine Fahrzeuge gefunden. Ist diese Seite eine Leitstelle mit zugeordneten Wachen?</p>`;
        return;
      }
      renderPerWache(panel, vehicles);
    } catch (e) {
      panel.innerHTML = `<p class="grisu-error">Fehler: ${e.message || e}</p>`;
    }
  }

  // â”€â”€â”€ Tab 1: Tabelle rendern â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

  function renderTable(panel, vehicles) {
    let searchVal  = '';
    let filterMode = 'all';
    let sortCol    = 'wache';
    let sortDir    = 1;

    function fmsInfo(code) {
      return FMS_INFO[code] || { text: `FMS ${code || '?'}`, cls: 'badge-none' };
    }

    function filterVehicle(v) {
      const hay = `${v.name} ${v.buildingName} ${v.typeLabel}`.toLowerCase();
      if (searchVal && !hay.includes(searchVal.toLowerCase())) return false;
      if (filterMode === 'all')        return true;
      if (filterMode === 'free')       return v.fmsCode === '1' || v.fmsCode === '2';
      if (filterMode === 'busy')       return v.fmsCode === '3' || v.fmsCode === '4';
      if (filterMode === 'sprech')     return v.fmsCode === '5';
      if (filterMode === 'notready')   return v.fmsCode === '6';
      return true;
    }

    function sortVehicles(list) {
      return [...list].sort((a, b) => {
        let va, vb;
        if (sortCol === 'wache')  { va = (a.buildingName || '').toLowerCase(); vb = (b.buildingName || '').toLowerCase(); }
        else if (sortCol === 'name')  { va = (a.name || '').toLowerCase();         vb = (b.name || '').toLowerCase(); }
        else if (sortCol === 'typ')   { va = (a.typeLabel || '').toLowerCase();     vb = (b.typeLabel || '').toLowerCase(); }
        else if (sortCol === 'fms')   { va = parseInt(a.fmsCode, 10) || 0;          vb = parseInt(b.fmsCode, 10) || 0; }
        else if (sortCol === 'crew')  { va = parseInt(a.crew, 10) || 0;             vb = parseInt(b.crew, 10) || 0; }
        if (va < vb) return -sortDir;
        if (va > vb) return  sortDir;
        return 0;
      });
    }

    function thCls(col) {
      return sortCol === col ? (sortDir === 1 ? 'sort-asc' : 'sort-desc') : '';
    }

    function render() {
      const filtered = vehicles.filter(filterVehicle);
      const sorted   = sortVehicles(filtered);

      const countFree     = vehicles.filter(v => v.fmsCode === '1' || v.fmsCode === '2').length;
      const countBusy      = vehicles.filter(v => v.fmsCode === '3' || v.fmsCode === '4').length;
      const countSprech    = vehicles.filter(v => v.fmsCode === '5').length;
      const countNotReady  = vehicles.filter(v => v.fmsCode === '6').length;

      let html = `
        <input class="grisu-search" type="text" placeholder="ðŸ” Fahrzeug, Wache oder Typ suchenâ€¦" value="${escHtml(searchVal)}" id="${TAB_ID}-search">
        <div class="grisu-filter-row">
          <span style="font-size:12px;color:#222;font-weight:700;margin-right:4px;">Filter:</span>
          <button class="grisu-btn-filter ${filterMode==='all'?'active':''}"      data-filter="all">Alle (${vehicles.length})</button>
          <button class="grisu-btn-filter ${filterMode==='free'?'active':''}"     data-filter="free">ðŸŸ¢ Frei (${countFree})</button>
          <button class="grisu-btn-filter ${filterMode==='busy'?'active':''}"     data-filter="busy">ðŸŸ  Im Einsatz (${countBusy})</button>
          <button class="grisu-btn-filter ${filterMode==='sprech'?'active':''}"   data-filter="sprech">ðŸ”´ Sprechwunsch (${countSprech})</button>
          <button class="grisu-btn-filter ${filterMode==='notready'?'active':''}" data-filter="notready">âš« Nicht einsatzbereit (${countNotReady})</button>
        </div>
        <div class="grisu-summary">${filtered.length} von ${vehicles.length} Fahrzeugen</div>
        <div class="grisu-table-wrap">
          <table class="grisu-tbl">
            <thead><tr>
              <th class="grisu-col-wache ${thCls('wache')}" data-col="wache">Wache</th>
              <th class="grisu-col-name ${thCls('name')}"   data-col="name">Fahrzeug</th>
              <th class="${thCls('typ')}"                   data-col="typ">Typ</th>
              <th class="${thCls('fms')}"                   data-col="fms">FMS-Status</th>
              <th class="${thCls('crew')}"                  data-col="crew">Besatzung (max.)</th>
            </tr></thead>
            <tbody>`;

      for (const v of sorted) {
        const info = fmsInfo(v.fmsCode);
        html += `
          <tr>
            <td class="grisu-col-wache">${v.buildingHref ? `<a class="grisu-link" href="${escHtml(v.buildingHref)}" target="_blank">${escHtml(v.buildingName)}</a>` : escHtml(v.buildingName)}</td>
            <td class="grisu-col-name">${v.vehicleId ? `<a class="grisu-link" href="/vehicles/${v.vehicleId}" target="_blank">${escHtml(v.name)}</a>` : escHtml(v.name)}</td>
            <td>${escHtml(v.typeLabel || 'â€“')}</td>
            <td><span class="grisu-badge ${info.cls}">S${v.fmsCode || '?'} Â· ${escHtml(info.text)}</span></td>
            <td style="text-align:center">${escHtml(v.crew || 'â€“')}</td>
          </tr>`;
      }

      html += `</tbody></table></div>`;

      const activeEl = document.activeElement;
      const activeId = activeEl && activeEl.id;
      const selStart = activeEl && typeof activeEl.selectionStart === 'number' ? activeEl.selectionStart : null;
      const selEnd   = activeEl && typeof activeEl.selectionEnd   === 'number' ? activeEl.selectionEnd   : null;

      panel.innerHTML = html;

      document.getElementById(`${TAB_ID}-search`).addEventListener('input', e => {
        searchVal = e.target.value; render();
      });
      panel.querySelectorAll('.grisu-btn-filter').forEach(btn => {
        btn.addEventListener('click', () => { filterMode = btn.dataset.filter; render(); });
      });
      panel.querySelectorAll('th[data-col]').forEach(th => {
        th.addEventListener('click', () => {
          const col = th.dataset.col;
          if (sortCol === col) sortDir *= -1;
          else { sortCol = col; sortDir = 1; }
          render();
        });
      });

      if (activeId) {
        const el = document.getElementById(activeId);
        if (el) {
          el.focus();
          if (selStart !== null && el.setSelectionRange) {
            el.setSelectionRange(selStart, selEnd);
          }
        }
      }
    }

    render();
  }

  // â”€â”€â”€ Tab 2: Fahrzeuge pro Wache rendern â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

  // Vereinfacht Fahrzeugnamen fÃ¼r die Gruppierung:
  // "BePol LA 0001 - DHuFÃ¼Kw/1" -> "DHuFÃ¼Kw"
  // (alles vor " - " sowie alles ab "/" wird ignoriert)
  function stripNumbering(name) {
    if (!name) return name;
    let s = name.trim();
    const dashIdx = s.indexOf(' - ');
    if (dashIdx !== -1) s = s.slice(dashIdx + 3);
    const slashIdx = s.indexOf('/');
    if (slashIdx !== -1) s = s.slice(0, slashIdx);
    return s.trim();
  }

  function renderPerWache(panel, vehicles) {
    // Gruppieren: Wache -> Fahrzeugtyp -> Anzahl
    const wachen = new Map(); // buildingName -> { href, types: Map(typeLabel -> count) }

    for (const v of vehicles) {
      const key = v.buildingName || '(unbekannte Wache)';
      if (!wachen.has(key)) {
        wachen.set(key, { href: v.buildingHref || '', types: new Map() });
      }
      const entry = wachen.get(key);
      const nameKey = stripNumbering(v.name) || '(unbekanntes Fahrzeug)';
      entry.types.set(nameKey, (entry.types.get(nameKey) || 0) + 1);
    }

    // Wachen alphabetisch sortieren
    const wacheNames = [...wachen.keys()].sort((a, b) => a.localeCompare(b, 'de'));

    let html = `<div class="grisu-summary">${wacheNames.length} Wachen Â· ${vehicles.length} Fahrzeuge gesamt</div>`;
    html += `<div class="grisu-wache-grid">`;

    for (const wacheName of wacheNames) {
      const entry = wachen.get(wacheName);
      // Fahrzeugnamen alphabetisch sortieren
      const typeNames = [...entry.types.keys()].sort((a, b) => a.localeCompare(b, 'de'));
      const total = [...entry.types.values()].reduce((s, n) => s + n, 0);

      html += `
        <div class="grisu-wache-block">
          <div class="grisu-wache-title">
            ${entry.href ? `<a class="grisu-link" href="${escHtml(entry.href)}" target="_blank">${escHtml(wacheName)}</a>` : escHtml(wacheName)}
            <span style="font-weight:400;color:#555;">(${total} Fahrzeuge)</span>
          </div>
          <div class="grisu-table-wrap">
            <table class="grisu-tbl">
              <thead><tr>
                <th>Fahrzeug</th>
                <th class="grisu-col-count">Anzahl</th>
              </tr></thead>
              <tbody>`;

      for (const typeName of typeNames) {
        html += `
              <tr>
                <td>${escHtml(typeName)}</td>
                <td class="grisu-col-count">${entry.types.get(typeName)}</td>
              </tr>`;
      }

      html += `</tbody></table></div></div>`;
    }

    html += `</div>`;

    panel.innerHTML = html;
  }

  // â”€â”€â”€ Initialisierung â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

  function init() {
    if (!location.pathname.startsWith('/buildings/')) return;
    if (!/\/buildings\/\d+$/.test(location.pathname)) return;

    const observer = new MutationObserver(() => {
      if (findTabContainer()) {
        observer.disconnect();
        injectStyles();
        injectTab();
        injectTab2();
      }
    });
    observer.observe(document.body, { childList: true, subtree: true });

    if (findTabContainer()) {
      observer.disconnect();
      injectStyles();
      injectTab();
      injectTab2();
    }
  }

  init();

})();
