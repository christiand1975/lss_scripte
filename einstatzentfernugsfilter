// ==UserScript==
// @name         LSS VB-Einsätze nach Wachen-Nähe filtern Beta
// @namespace    Grisu-lss-tools
// @version      1.0.0
// @description  Blendet Verbandseinsätze aus, deren nächste eigene Wache weiter als eine einstellbare Distanz entfernt ist. Dropdown erscheint direkt über der Verbandseinsatzliste.
// @match        https://www.leitstellenspiel.de/*
// @grant        none
// @run-at       document-idle
// ==/UserScript==

(function () {
  'use strict';

  const STORAGE_KEY = 'lssVbNaeheFilter_maxDistanceKm';
  const ALLIANCE_LIST_ID = 'mission_list_alliance';

  // Auswahlmöglichkeiten im Dropdown (km). null = keine Grenze.
  const DISTANCE_OPTIONS = [0, 100, 200, 300, 400, 500, null];

  function getSavedDistance() {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw === null || raw === 'null') return null;
    const n = Number(raw);
    return Number.isFinite(n) ? n : null;
  }

  function saveDistance(value) {
    localStorage.setItem(STORAGE_KEY, value === null ? 'null' : String(value));
  }

  function haversineKm(lat1, lng1, lat2, lng2) {
    const R = 6371;
    const dLat = ((lat2 - lat1) * Math.PI) / 180;
    const dLng = ((lng2 - lng1) * Math.PI) / 180;
    const a =
      Math.sin(dLat / 2) ** 2 +
      Math.cos((lat1 * Math.PI) / 180) *
        Math.cos((lat2 * Math.PI) / 180) *
        Math.sin(dLng / 2) ** 2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }

  // Eigene Wachen-Koordinaten einmal einsammeln (buildings_data enthält nur
  // eigene Gebäude, siehe vorherige Analyse)
  function getOwnWachenCoords() {
    if (typeof buildings_data === 'undefined') return [];
    return Array.from(buildings_data.values())
      .filter((b) => b.latitude != null && b.longitude != null)
      .map((b) => ({ lat: b.latitude, lng: b.longitude }));
  }

  function distanceToNearestWache(lat, lng, wachen) {
    let min = Infinity;
    for (const w of wachen) {
      const d = haversineKm(lat, lng, w.lat, w.lng);
      if (d < min) min = d;
    }
    return min;
  }

  function applyFilter() {
    const maxDistance = getSavedDistance();
    const container = document.getElementById(ALLIANCE_LIST_ID);
    if (!container || typeof missions_data === 'undefined') return;

    const wachen = getOwnWachenCoords();
    if (wachen.length === 0) return; // keine eigenen Wachen bekannt -> nichts filtern

    container.querySelectorAll('[id^="mission_panel_heading_"]').forEach((heading) => {
      const id = Number(heading.id.replace('mission_panel_heading_', ''));
      const panel = heading.closest('.panel') || heading.parentElement;
      if (!panel) return;

      if (maxDistance === null) {
        panel.style.display = '';
        return;
      }

      const mission = missions_data.get(id);
      if (!mission || mission.latitude == null || mission.longitude == null) {
        panel.style.display = '';
        return;
      }

      const distance = distanceToNearestWache(mission.latitude, mission.longitude, wachen);
      panel.style.display = distance <= maxDistance ? '' : 'none';
    });
  }

  function buildDropdown() {
    const wrapper = document.createElement('div');
    wrapper.id = 'lssVbNaeheFilterWrapper';
    wrapper.style.padding = '4px 8px';
    wrapper.style.display = 'flex';
    wrapper.style.alignItems = 'center';
    wrapper.style.gap = '6px';

    const label = document.createElement('label');
    label.textContent = 'Max. Entfernung zur nächsten eigenen Wache:';
    label.style.fontSize = '12px';
    label.setAttribute('for', 'lssVbNaeheFilterSelect');

    const select = document.createElement('select');
    select.id = 'lssVbNaeheFilterSelect';
    select.className = 'form-control input-sm';
    select.style.width = 'auto';
    select.style.display = 'inline-block';

    DISTANCE_OPTIONS.forEach((km) => {
      const opt = document.createElement('option');
      opt.value = km === null ? 'null' : String(km);
      opt.textContent = km === null ? 'Keine Grenze' : `${km} km`;
      select.appendChild(opt);
    });

    const current = getSavedDistance();
    select.value = current === null ? 'null' : String(current);

    select.addEventListener('change', () => {
      const val = select.value === 'null' ? null : Number(select.value);
      saveDistance(val);
      applyFilter();
    });

    wrapper.appendChild(label);
    wrapper.appendChild(select);
    return wrapper;
  }

  function ensureDropdown() {
    if (document.getElementById('lssVbNaeheFilterWrapper')) return;
    const container = document.getElementById(ALLIANCE_LIST_ID);
    if (!container || !container.parentElement) return;
    container.parentElement.insertBefore(buildDropdown(), container);
  }

  let debounceTimer = null;
  function scheduleUpdate() {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      ensureDropdown();
      applyFilter();
    }, 400);
  }

  function init() {
    ensureDropdown();
    applyFilter();

    const container = document.getElementById(ALLIANCE_LIST_ID);
    if (container) {
      const observer = new MutationObserver(scheduleUpdate);
      observer.observe(container, { childList: true, subtree: true });
    }
  }

  init();

  // Für manuelle Tests in der Konsole
  window.lssVbNaeheFilter = { applyFilter, getSavedDistance, saveDistance };
})();
