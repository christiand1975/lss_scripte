// ==UserScript==
// @name         LSS Leitstellen Wachen-Übersicht Version Alpha
// @namespace    https://www.leitstellenspiel.de/
// @version      2.2.0
// @description  Zeigt in der Leitstelle einen Tab mit allen zugehörigen Wachen, deren Ausbauten, Personalstatus und Fahrzeug-Vollständigkeit
// @author       Grisu
// @match        https://www.leitstellenspiel.de/buildings/*
// @grant        GM_xmlhttpRequest
// @connect      www.leitstellenspiel.de
// ==/UserScript==

(function () {
  'use strict';

  const TAB_ID   = 'grisu-leitstelle-uebersicht';
  const STYLE_ID = 'grisu-leitstelle-style';
  const LSS_BASE = 'https://www.leitstellenspiel.de';

  // ─── Hilfsfunktionen ───────────────────────────────────────────────────────

  function fetchJSON(url) {
    return new Promise((resolve, reject) => {
      GM_xmlhttpRequest({
        method: 'GET',
        url: LSS_BASE + url,
        responseType: 'json',
        onload: r => {
          try {
            const data = typeof r.response === 'object' ? r.response : JSON.parse(r.responseText);
            resolve(data);
          } catch (e) { reject(e); }
        },
        onerror: reject,
      });
    });
  }

  // Lädt eine normale HTML-Gebäudeseite als parsbares Dokument
  // (wird für "Fahrzeuge: X von maximal Y" benötigt, da das nicht
  // in der /api/buildings/{id}-JSON-Antwort enthalten ist).
  function fetchDoc(url) {
    return new Promise((resolve, reject) => {
      GM_xmlhttpRequest({
        method: 'GET',
        url: LSS_BASE + url,
        responseType: 'document',
        onload: r => {
          if (r.response && r.response.querySelector) {
            resolve(r.response);
            return;
          }
          try {
            const doc = new DOMParser().parseFromString(r.responseText, 'text/html');
            resolve(doc);
          } catch (e) { reject(e); }
        },
        onerror: reject,
      });
    });
  }

  function getCurrentBuildingId() {
    const m = location.pathname.match(/\/buildings\/(\d+)/);
    return m ? m[1] : null;
  }

  function getBuildingTypeName(type) {
    // Zuordnung anhand der von der API gelieferten Icon-Dateinamen
    // (building_type -> Icon), Stand: verifiziert an einer BePo-Wache.
    // Einträge mit "(?)" nutzen ein wiederverwendetes Icon (z.B. selbes
    // Polizeiwache-Bild wie Typ 6) -> Name ist eine plausible Annahme,
    // aber nicht 1:1 bestätigt wie 6/9/11.
    const map = {
      0:  'Feuerwache',
      1:  'Feuerwehrschule',
      2:  'Rettungswache',
      3:  'Rettungsschule',
      4:  'Krankenhaus',
      5:  'RTH-Station',
      6:  'Polizeiwache',
      7:  'Leitstelle',
      8:  'Polizeischule',
      9:  'THW-Ortsverband',
      10: 'THW-Schule',
      11: 'Bereitschaftspolizei (BePo)',
      12: 'SEG',
      13: 'Hubschrauberlandeplatz (Polizei)',
      14: 'Bereitstellungsraum',
      15: 'Wasserwacht',
      16: 'Polizeiwache (groß) (?)',
      17: 'Polizei-Sondereinheiten (SEK/MEK)',
      18: 'Feuerwache (groß) (?)',
      19: 'Bundespolizei-Wache (?)',
      20: 'Rettungswache (groß) (?)',
      21: 'Rettungshundestaffel',
      22: 'Verbandsgebäude',
      23: 'Verbandsgebäude (2) (?)',
      24: 'Polizei-Reiterstaffel',
      25: 'Bergrettung',
      26: 'Seenotrettung',
      27: 'Seenotrettungsschule',
      28: 'Wasserrettungs-Hubschrauberlandeplatz',
      29: 'Autobahnpolizei',
    };
    return map[type] || `Typ ${type}`;
  }

  function escHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  // Personal-Status auf Basis von personal_count / personal_count_target
  function getPersonalStatus(b) {
    const cur = b.personal_count || 0;
    const tgt = b.personal_count_target || 0;
    if (tgt === 0) return { cls: 'badge-none', text: `${cur} Personal`, title: 'Kein Ziel gesetzt' };
    const ratio = cur / tgt;
    if (ratio >= 1)    return { cls: 'badge-ok',      text: `${cur}/${tgt} ✓`,  title: 'Personal vollständig' };
    if (ratio >= 0.75) return { cls: 'badge-partial',  text: `${cur}/${tgt} ⚠`, title: `${tgt - cur} fehlen noch` };
    return               { cls: 'badge-missing',  text: `${cur}/${tgt} ✗`,  title: `${tgt - cur} Personal fehlen` };
  }

  // Fahrzeug-Vollständigkeit aus der Gebäude-HTML-Seite:
  // "Fahrzeuge: X von maximal Y" (dt/dd-Paar), bei allen Wachentypen gleich aufgebaut.
  function parseVehicleCounts(doc) {
    const dts = [...doc.querySelectorAll('dt')];
    const fzgDt = dts.find(dt => dt.textContent.trim().startsWith('Fahrzeuge:'));
    if (!fzgDt) return { current: null, max: null };
    const dd = fzgDt.nextElementSibling;
    if (!dd) return { current: null, max: null };
    const m = dd.textContent.match(/(\d+)\s+von\s+maximal\s+(\d+)/);
    if (!m) return { current: null, max: null };
    return { current: parseInt(m[1], 10), max: parseInt(m[2], 10) };
  }

  function getVehicleStatus(b) {
    if (b.vehicle_current == null || b.vehicle_max == null) {
      return { complete: false, known: false, text: '–' };
    }
    const complete = b.vehicle_max > 0 && b.vehicle_current >= b.vehicle_max;
    return { complete, known: true, text: `${b.vehicle_current}/${b.vehicle_max}` };
  }

  // Ausbau-Badges: available / enabled
  function getExtBadges(extensions) {
    if (!extensions || extensions.length === 0) {
      return `<span class="grisu-badge badge-noext">Keine Ausbauten</span>`;
    }
    return [...extensions].sort((a, b) => (a.caption || '').localeCompare(b.caption || '', 'de')).map(ext => {
      if (!ext.available) {
        return `<span class="grisu-badge badge-missing" title="Nicht gebaut">✗ ${escHtml(ext.caption)}</span>`;
      }
      if (!ext.enabled) {
        return `<span class="grisu-badge badge-partial" title="Deaktiviert">⏸ ${escHtml(ext.caption)}</span>`;
      }
      return `<span class="grisu-badge badge-ok" title="Aktiv">✓ ${escHtml(ext.caption)}</span>`;
    }).join('');
  }

  // Problemscore: fehlende/deaktivierte Ausbauten + Unterbesetzung + fehlende Fahrzeuge
  function problemScore(b) {
    let score = 0;
    for (const ext of (b.extensions || [])) {
      if (!ext.available) score += 2;
      else if (!ext.enabled) score += 1;
    }
    const cur = b.personal_count || 0;
    const tgt = b.personal_count_target || 0;
    if (tgt > 0) {
      const ratio = cur / tgt;
      if (ratio < 0.75) score += 3;
      else if (ratio < 1) score += 1;
    }
    if (b.vehicle_current != null && b.vehicle_max != null && b.vehicle_max > 0 && b.vehicle_current < b.vehicle_max) {
      score += 1;
    }
    return score;
  }

  // ─── CSS ───────────────────────────────────────────────────────────────────

  function injectStyles() {
    if (document.getElementById(STYLE_ID)) return;
    const s = document.createElement('style');
    s.id = STYLE_ID;
    s.textContent = `
#${TAB_ID}-panel {
  padding: 12px 4px;
  font-size: 13px;
}
#${TAB_ID}-panel .grisu-search {
  width: 100%;
  max-width: 360px;
  margin-bottom: 12px;
  padding: 5px 10px;
  border: 1px solid #999 !important;
  border-radius: 4px;
  font-size: 13px;
  box-sizing: border-box;
  color: #222 !important;
  background: #fff !important;
}
#${TAB_ID}-panel .grisu-filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 14px;
  align-items: center;
}
#${TAB_ID}-panel .grisu-btn-filter {
  padding: 4px 12px;
  border-radius: 12px;
  border: 2px solid #222 !important;
  background: #333 !important;
  color: #fff !important;
