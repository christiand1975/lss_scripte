// ==UserScript==
// @name         LSS Event-Sammelsymbol-Finder
// @namespace    https://leitstellenspiel.de/
// @version      1.0.0
// @description  Hebt Einsätze mit Event-Sammelsymbolen (Sonnenblumen, Schneeflocken, Ostereier, Herzen, Kürbisse, ...) in der Einsatzliste hervor und zeigt eine Sprung-Liste an
// @author       Christian
// @match        https://www.leitstellenspiel.de/*
// @grant        none
// @run-at       document-idle
// ==/UserScript==

(function () {
    'use strict';

    // ---------------------------------------------------------------
    // Konfiguration
    // ---------------------------------------------------------------

    // Keywords, nach denen in src/alt/title von <img> gesucht wird.
    // Bei Bedarf erweitern, wenn ein neues Event-Icon dazukommt.
    const EVENT_ICON_KEYWORDS = [
        'sonnenblume', 'sunflower',
        'schneeflocke', 'snowflake',
        'osterei', 'easter',
        'herz', 'heart',
        'kuerbis', 'kürbis', 'pumpkin',
        'weihnachtsmann', 'santa',
        'flagge', 'flag'
    ];

    // Wie oft neu gescannt wird (ms), zusätzlich zum MutationObserver
    const RESCAN_INTERVAL_MS = 3000;

    // ---------------------------------------------------------------
    // Hilfsfunktionen
    // ---------------------------------------------------------------

    function looksLikeEventIcon(img) {
        const haystack = [
            img.getAttribute('src') || '',
            img.getAttribute('alt') || '',
            img.getAttribute('title') || ''
        ].join(' ').toLowerCase();

        return EVENT_ICON_KEYWORDS.some(kw => haystack.includes(kw));
    }

    // Findet die "Zeile" eines Einsatzes ausgehend vom Icon.
    // LSS-Markup ändert sich gelegentlich, daher mehrere Kandidaten probieren.
    function findMissionRow(icon) {
        const candidates = [
            '.missionRow',
            '.mission_type_row',
            'tr',
            'li',
            '.list-group-item',
            '.panel'
        ];
        for (const sel of candidates) {
            const el = icon.closest(sel);
            if (el) return el;
        }
        // Fallback: 3 Ebenen nach oben
        return icon.parentElement?.parentElement?.parentElement || icon.parentElement;
    }

    function highlightRow(row) {
        if (!row || row.dataset.eventIconMarked === '1') return;
        row.dataset.eventIconMarked = '1';
        row.style.outline = '3px solid #ffb400';
        row.style.outlineOffset = '-2px';
        row.style.backgroundColor = 'rgba(255, 180, 0, 0.15)';
        row.style.transition = 'background-color 0.3s ease';
    }

    // ---------------------------------------------------------------
    // Scan + Panel
    // ---------------------------------------------------------------

    let foundRows = [];

    function scan() {
        const images = document.querySelectorAll('img');
        foundRows = [];

        images.forEach(img => {
            if (looksLikeEventIcon(img)) {
                const row = findMissionRow(img);
                if (row) {
                    highlightRow(row);
                    foundRows.push(row);
                }
            }
        });

        updatePanel();
    }

    function updatePanel() {
        let panel = document.getElementById('lss-event-icon-panel');
        if (!panel) {
            panel = document.createElement('div');
            panel.id = 'lss-event-icon-panel';
            panel.style.position = 'fixed';
            panel.style.bottom = '16px';
            panel.style.right = '16px';
            panel.style.zIndex = '9999';
            panel.style.background = '#222';
            panel.style.color = '#fff';
            panel.style.padding = '10px 14px';
            panel.style.borderRadius = '8px';
            panel.style.fontSize = '13px';
            panel.style.fontFamily = 'sans-serif';
            panel.style.boxShadow = '0 2px 8px rgba(0,0,0,0.4)';
            panel.style.cursor = 'pointer';
            panel.style.userSelect = 'none';
            document.body.appendChild(panel);

            let currentIndex = 0;
            panel.addEventListener('click', () => {
                if (foundRows.length === 0) return;
                currentIndex = currentIndex % foundRows.length;
                foundRows[currentIndex].scrollIntoView({ behavior: 'smooth', block: 'center' });
                currentIndex++;
            });
        }

        panel.textContent = foundRows.length > 0
            ? `🌻 ${foundRows.length} Einsatz(e) mit Sammelsymbol – klicken zum Springen`
            : '🌻 Keine Sammelsymbole aktuell sichtbar';
    }

    // ---------------------------------------------------------------
    // Start
    // ---------------------------------------------------------------

    scan();

    const observer = new MutationObserver(() => scan());
    observer.observe(document.body, { childList: true, subtree: true });

    setInterval(scan, RESCAN_INTERVAL_MS);
})();
